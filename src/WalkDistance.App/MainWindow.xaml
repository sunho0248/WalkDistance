<Window x:Class="WalkDistance.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WalkDistance.App"
        mc:Ignorable="d"
        Title="보행거리 계산" Height="700" Width="1000" MinHeight="500" MinWidth="760"
        PreviewKeyDown="OnWindowPreviewKeyDown" Closing="OnWindowClosing">
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+S" Command="Save"/>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="SaveAs"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="Save" Executed="OnSaveCurrentProject"/>
        <CommandBinding Command="SaveAs" Executed="OnSaveProjectAs"/>
    </Window.CommandBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="파일(_F)">
                <MenuItem Header="DXF 열기(_O)" Click="OnOpenDxf"/>
                <Separator/>
                <MenuItem Header="프로젝트 저장(_S)" Command="Save" InputGestureText="Ctrl+S"/>
                <MenuItem Header="다른 이름으로 저장(_A)" Command="SaveAs" InputGestureText="Ctrl+Shift+S"/>
                <MenuItem Header="프로젝트 열기(_P)" Click="OnOpenProject"/>
                <Separator/>
                <MenuItem Header="종료(_X)" Click="OnExit"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="DXF 파일을 불러오세요."/>
            </StatusBarItem>
            <StatusBarItem>
                <ProgressBar x:Name="CalculationProgress" Width="140" Height="14"
                             Minimum="0" Maximum="4" Visibility="Collapsed"/>
            </StatusBarItem>
        </StatusBar>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <ToggleButton x:Name="AddExitToggle" Content="출구 지정 모드" Width="100"
                              Checked="OnAddExitModeChanged" Unchecked="OnAddExitModeChanged"/>
                <Button Content="출구 전체 초기화" Click="OnClearExits"/>
                <Separator/>
                <ToggleButton x:Name="ZoomWindowToggle" Content="Zoom Window" Width="95"
                              Checked="OnZoomWindowModeChanged" Unchecked="OnZoomWindowModeChanged"
                              ToolTip="화면에서 확대할 영역을 드래그하세요. Esc: 취소"/>
                <Separator/>
                <TextBlock Text="고정 길이(m):" VerticalAlignment="Center" Margin="4,0"/>
                <TextBox x:Name="FixedExitLengthBox" Width="50" VerticalAlignment="Center"
                         ToolTip="비우면 두 번 클릭하는 직선 출구 · 값을 입력하면 마우스 위치가 중심인 전체 길이를 벽 따라 실시간 미리보기 · 클릭하면 미리보기 그대로 확정"/>
                <Separator/>
                <TextBlock Text="셀 크기(m):" VerticalAlignment="Center" Margin="4,0"/>
                <TextBox x:Name="CellSizeBox" Width="50" Text="0.2" VerticalAlignment="Center"
                         TextChanged="OnCellSizeChanged"/>
                <Separator/>
                <TextBlock Text="어깨너비(m):" VerticalAlignment="Center" Margin="4,0"/>
                <TextBox x:Name="ShoulderWidthBox" Width="50" Text="0.40" VerticalAlignment="Center"
                         TextChanged="OnBodyProfileChanged"/>
                <TextBlock Text="몸통둘레(m):" VerticalAlignment="Center" Margin="4,0"/>
                <TextBox x:Name="TorsoCircumferenceBox" Width="50" Text="0.95" VerticalAlignment="Center"
                         TextChanged="OnBodyProfileChanged"/>
                <Separator/>
                <TextBlock Text="기준거리(m):" VerticalAlignment="Center" Margin="4,0"/>
                <TextBox x:Name="ThresholdBox" Width="55" VerticalAlignment="Center"
                         TextChanged="OnThresholdChanged" LostFocus="OnThresholdLostFocus" KeyDown="OnThresholdKeyDown"
                         ToolTip="비우면 끔 · 보라색: 기준거리 초과(d &gt; 기준) · 흰 선: 기준 경계"/>
                <Separator/>
                <Button x:Name="CalculateButton" Content="보행거리 계산" FontWeight="Bold" Click="OnCalculate"/>
                <Separator/>
                <CheckBox x:Name="MapOverlayToggle" Content="디스턴스 맵" IsChecked="True"
                          Checked="OnOverlayToggleChanged" Unchecked="OnOverlayToggleChanged" Margin="4,0"/>
                <CheckBox x:Name="PathOverlayToggle" Content="보행경로" IsChecked="True"
                          Checked="OnOverlayToggleChanged" Unchecked="OnOverlayToggleChanged" Margin="4,0"/>
                <Separator/>
                <TextBlock Text="출구 모드 켬: 일반 출구는 두 번 클릭(자동 스냅) · 고정 길이는 마우스 위치가 중심인 전체 벽 경로를 미리보기 그대로 클릭해 확정 · Esc: 모드 종료/그리기 취소/조회 지우기 · 출구 모드 끔: 완료된 출구 클릭해 선택 후 Delete로 삭제 · 벽 클릭 위치가 중심이 되도록 기존 길이/방향으로 이동 · 휠: 포인터 중심 확대/축소 · 가운데 버튼 드래그: 화면 이동 · 가운데 버튼 더블클릭: 전체 보기"
                           Foreground="DimGray" VerticalAlignment="Center" Margin="4,0"/>
            </ToolBar>
        </ToolBarTray>

        <Border BorderBrush="Gray" BorderThickness="1" Background="White">
            <Canvas x:Name="DrawingCanvas" ClipToBounds="True" Background="Transparent"
                    Focusable="True"
                    SizeChanged="OnCanvasSizeChanged"
                    MouseMove="OnCanvasMouseMove"
                    MouseLeftButtonDown="OnCanvasLeftClick"
                    MouseRightButtonDown="OnCanvasRightClick"
                    PreviewMouseDown="OnCanvasMouseDown"
                    PreviewMouseUp="OnCanvasMouseUp"
                    MouseDown="OnCanvasMouseDown"
                    MouseUp="OnCanvasMouseUp"
                    MouseWheel="OnCanvasMouseWheel"
                    KeyDown="OnCanvasKeyDown"/>
        </Border>
    </DockPanel>
</Window>
